# 이 파일을 .env.local / .env.prod 로 복사해서 값을 채운다.
# 셸 환경변수가 항상 우선하므로 배포 환경에서는 파일 없이 써도 된다.

# local | prod  (manage.py 실행 시 DJANGO_ENV 로 넘겨도 된다)
DJANGO_ENV=local

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=0.1.0

# 웹 오리진. 쿠키를 주고받으므로 정확히 적어야 한다 (와일드카드 불가)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 웹과 API가 같은 상위 도메인을 쓸 때만 채운다. 예) .alrimi.app
REFRESH_COOKIE_DOMAIN=

# ntfy 서버 주소. 구독 QR·링크 조립과 발송이 모두 여기를 본다
NTFY_BASE_URL=https://ntfy.sh
# 발행 계정. ACL 을 건 서버에서만 필요하다 (열린 서버면 비워둔다)
NTFY_USER=
NTFY_PASSWORD=
# 상세 화면의 "보내기" 가 기다리는 시간
NTFY_TIMEOUT_SECONDS=5

# 크론이 /events/weekly, /events/alerts 를 부를 때 X-API-KEY 헤더에 싣는 값.
# 아무 난수나 길게 넣는다. 예) python -c "import secrets;print(secrets.token_urlsafe(32))"
# prod 는 반드시 채워야 한다 (없으면 부팅 단계에서 멈춘다).
N8N_API_KEY=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ── PostgreSQL ────────────────────────────────────────────
# prod 는 반드시 채워야 한다. local 은 POSTGRES_DB 가 있을 때만 postgres 를 쓰고
# 없으면 sqlite 다. docker compose 로 띄우면 compose 가 직접 넣어주므로 비워둬도 된다 —
# 호스트의 runserver 로 컨테이너 db 에 붙을 때만 채운다.
# POSTGRES_DB=alrimi
# POSTGRES_USER=alrimi
# POSTGRES_PASSWORD=alrimi-local
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# ── prod 전용 ─────────────────────────────────────────────
# SECURE_SSL_REDIRECT=true
